# Store real values in .env locally or encrypted GitHub Actions secrets. Never commit them.
CLIP_API_URL=https://your-api.example/api/v1/posts/clip
CLIP_API_TOKEN=
S3_BUCKET=your-private-bucket-name
S3_REGION=ap-south-1
S3_ENDPOINT_URL=
PUBLIC_BASE_URL=https://media.example.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
INSTAGRAM_SESSION_USERNAME=
INSTAGRAM_SESSION_ID=
INSTAGRAM_SESSION_FILE=./data/instagram-session
INSTAGRAM_PROVIDER=instaloader
INSTAGRAM_GRAPH_ACCESS_TOKEN=
INSTAGRAM_GRAPH_API_VERSION=v24.0
PROFILES_FILE=./profiles.json
DATABASE_PATH=./data/monitor.db
DATABASE_OBJECT_KEY=automation/instagram-reel-monitor/monitor.db
LEGACY_STATE_OBJECT_KEY=automation/instagram-reel-monitor/state.json
SCAN_LIMIT=30
ACCOUNTS_PER_RUN=20
MAX_NEW_REELS_PER_PROFILE=2
MAX_PUBLISH_PER_RUN=20
LOOKBACK_HOURS=48
MAX_VIDEO_BYTES=262144000
REQUEST_ATTEMPTS=4
ONLY_CITY_CODE=
SYNC_MODE=incremental
BACKFILL_SINCE=
DRY_RUN=false
